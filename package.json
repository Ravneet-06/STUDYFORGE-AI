{
  "name": "studyforge-ai",
  "version": "0.1.0",
  "private": true,
  "description": "Autonomous multi-agent AI study platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "start": "node apps/api/server.mjs",
    "dev": "node --watch apps/api/server.mjs",
    "build": "node scripts/build.mjs",
    "validate:foundation": "node scripts/validate-foundation.mjs",
    "health:foundation": "node scripts/validate-foundation.mjs",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "security:check": "npm audit --audit-level=high && node scripts/validate-foundation.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.2",
    "eslint": "10.11.0",
    "globals": "17.12.0",
    "prettier": "3.9.8",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
}
