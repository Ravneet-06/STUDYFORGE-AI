# Copy this file to .env.local for local development.
# Never commit real values. Keep service-role and server credentials backend-only.

NODE_ENV=development
LOG_LEVEL=info

# Supabase (set both URL and anon key to enable authenticated provider mode)
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Reserved for authorized backend workers; not used by the local MVP API.
SUPABASE_SERVICE_ROLE_KEY=

# Microsoft Foundry / Azure (required by the agent phase; intentionally blank here)
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
AZURE_RESOURCE_GROUP=
AZURE_AI_PROJECT_ENDPOINT=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21

# Application URLs
WEB_ORIGIN=http://localhost:3000
API_PORT=4000
