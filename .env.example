# Copy this file to .env.local for local development.
# Never commit real values. Keep service-role and server credentials backend-only.

NODE_ENV=development
LOG_LEVEL=info

# Supabase (required by the data phase; intentionally blank here)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Microsoft Foundry / Azure (required by the agent phase; intentionally blank here)
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
AZURE_RESOURCE_GROUP=
AZURE_AI_PROJECT_ENDPOINT=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=

# Application URLs
WEB_ORIGIN=http://localhost:3000
API_PORT=4000
